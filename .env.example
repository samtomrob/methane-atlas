# Methane Atlas — secrets template.
# Copy to .env (gitignored) and fill in. Full setup steps: docs/CREDENTIALS.md
# Verify with: cd pipeline && uv run matlas auth-check

# --- Phase 1: Sentinel-5P TROPOMI via Copernicus Data Space ---
# OAuth client: shapps.dataspace.copernicus.eu/dashboard -> User Settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# S3 keys: eodata-s3keysmanager.dataspace.copernicus.eu -> Add Credentials
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# Optional fallback if the OAuth client can't authorise downloads (skip if 2FA is on)
CDSE_USERNAME=
CDSE_PASSWORD=

# --- Phase 1: Earth Engine backfill (service account, not an API key) ---
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON_PATH=secrets/gee-service-account.json

# --- Phase 2: plume detections ---
EARTHDATA_TOKEN=
CARBON_MAPPER_TOKEN=

# --- Phase 4: deforestation & carbon ---
GFW_API_KEY=

# --- Publishing: Cloudflare R2 (S3 API) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=methane-atlas
