# Methane Atlas — secrets template. Copy to .env (never committed) and fill
# as accounts are created. Names match `requires:` fields in data-catalog/.

# Phase 1 — TROPOMI
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
GEE_SERVICE_ACCOUNT_JSON_PATH=

# Phase 2 — plumes
EARTHDATA_TOKEN=
CARBON_MAPPER_TOKEN=

# Phase 4 — deforestation/carbon
GFW_API_KEY=

# Publishing — Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=methane-atlas
