# secrets — never commit. secrets/ holds key files (e.g. the GEE service
# account JSON); .env holds everything else.
.env
.env.*
!.env.example
secrets/
*.pem
*-service-account*.json

# python
__pycache__/
*.pyc
.venv/
pipeline/dist/

# node / next
node_modules/
web/.next/
web/out/
web/next-env.d.ts

# desktop build output — a 32 MB binary rebuilt by desktop/build.ps1 from
# sources that are tracked. The icon IS tracked, since it is generated once
# and needed by the spec.
build/
dist/
*.exe

# local data staging at repo root only (published artifacts live in object
# storage, not git; the small v0 GeoJSONs in web/public/data ARE committed)
/data/
*.tar.gz

# editors / os
.DS_Store
Thumbs.db
